# Frontend dev image: Node 24 + standalone pnpm.
#
# Like the app image, this holds no source — the worktree is bind-mounted at
# /rspace at runtime. The entrypoint installs dependencies into a named volume
# and starts the Vite dev server with HMR.
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE}

# The standalone install survives Node changes; pnpm follows packageManager at runtime.
ENV PNPM_HOME=/opt/pnpm
ENV PATH="/opt/pnpm/bin:${PATH}"
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://get.pnpm.io/install.sh -o /tmp/install-pnpm.sh \
    && ENV=/tmp/pnpm-shell.sh SHELL=/bin/sh sh /tmp/install-pnpm.sh \
    && rm /tmp/install-pnpm.sh /tmp/pnpm-shell.sh

COPY entrypoint-frontend.sh /usr/local/bin/entrypoint-frontend.sh
RUN chmod +x /usr/local/bin/entrypoint-frontend.sh

WORKDIR /rspace
EXPOSE 5173
ENTRYPOINT ["/usr/local/bin/entrypoint-frontend.sh"]
