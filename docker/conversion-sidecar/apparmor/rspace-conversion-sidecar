# AppArmor profile for the RSpace conversion sidecar container.
#
# Docker's default profile (github.com/moby/profiles/apparmor/template.go), with its
# `deny mount` replaced by the rules bubblewrap needs to build each LibreOffice sandbox:
# a user namespace, mounts inside it, and pivot_root into the new root. Load it on the
# Docker host before starting the container:
#
#   sudo apparmor_parser -r -W docker/conversion-sidecar/apparmor/rspace-conversion-sidecar
#
# then run the container with `--security-opt apparmor=rspace-conversion-sidecar`.
# Requires AppArmor 4 (Ubuntu 24.04 and later) for the `userns` rule.

abi <abi/4.0>,

#include <tunables/global>

profile rspace-conversion-sidecar flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  unix,
  # Disallow obsolete socket families removed from the Linux kernel.
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  # Disallow AF_ALG (Linux kernel crypto API).
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  capability,
  file,

  # bubblewrap: unprivileged user namespace, then mounts and pivot_root inside it.
  # Ubuntu's kernel.apparmor_restrict_unprivileged_userns honours this rule.
  userns,
  mount,
  remount,
  umount,
  pivot_root,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer=docker-default,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=rspace-conversion-sidecar,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer=rspace-conversion-sidecar,
}
