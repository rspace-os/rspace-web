<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd">

    <changeSet id="2026-09-09a" context="run" author="matthias">
        <comment>Create SampleRequest table (RSDEV-1366)</comment>

        <!-- id is assigned from hibernate_sequences, so not autoIncrement. -->
        <createTable tableName="SampleRequest">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sample_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_samplerequest_sample"
                             references="Sample(id)"/>
            </column>
            <!-- username, not an FK: the record must survive the requester's deletion -->
            <column name="requesterUsername" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- sample_id is indexed by InnoDB as a foreign key; requesterUsername is not an FK, but the
             role=REQUESTER listing filters on it -->
        <createIndex tableName="SampleRequest" indexName="idx_samplerequest_requesterUsername">
            <column name="requesterUsername"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
