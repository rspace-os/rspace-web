<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd">

    <!-- DBRepo integration -->
    <changeSet id="2026-08-25a" context="run" author="akos326">
        <comment>Create a new app - DBRepo</comment>
        <insert tableName="App">
            <column name="id" type="NUMERIC" value="NULL"/>
            <column name="label" type="STRING" value="DBRepo"/>
            <column name="name" type="STRING" value="app.dbrepo"/>
            <column name="defaultEnabled" type="BOOLEAN" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="2026-08-25b" context="run" author="akos326">
        <comment>Create a new system property for DBRepo</comment>
        <insert tableName="PropertyDescriptor">
            <column name="id" type="NUMERIC" value="NULL"/>
            <column name="defaultValue" type="STRING" value="DENIED"/>
            <column name="name" type="STRING" value="dbrepo.available"/>
            <column name="type" type="NUMERIC" value="3"/>
        </insert>
        <insert tableName="SystemProperty">
            <column name="id" type="NUMERIC" value="NULL"/>
            <column name="dependent_id" type="NUMERIC" value="NULL"/>
            <column name="descriptor_id" type="NUMERIC"
                    valueComputed="(select id from PropertyDescriptor where name ='dbrepo.available')"/>
        </insert>
        <insert tableName="SystemPropertyValue">
            <column name="id" type="NUMERIC" value="NULL"/>
            <column name="value" type="String" value="DENIED"/>
            <column name="property_id" type="NUMERIC"
                    valueComputed="(select sp.id from SystemProperty sp inner join PropertyDescriptor pd on sp.descriptor_id=pd.id where pd.name='dbrepo.available')"/>
        </insert>
    </changeSet>

    <changeSet id="2026-08-25c" context="run" author="akos326">
        <comment>Property descriptor for the DBRepo endpoint URL</comment>
        <insert tableName="PropertyDescriptor">
            <column name="id" type="NUMERIC" value="NULL"/>
            <column name="defaultValue" type="STRING" value=""/>
            <column name="name" type="STRING" value="DBREPO_URL"/>
            <column name="type" type="NUMERIC" value="2"/>
        </insert>
    </changeSet>

    <changeSet id="2026-08-25d" context="run" author="akos326">
        <comment>AppConfigElementDescriptor for the DBRepo endpoint URL</comment>
        <sql>insert into AppConfigElementDescriptor (id, descriptor_id, app_id)
            select null, pd.id, app.id
            from PropertyDescriptor pd, App app
            where app.name='app.dbrepo' and pd.name='DBREPO_URL';
        </sql>
    </changeSet>

</databaseChangeLog>
