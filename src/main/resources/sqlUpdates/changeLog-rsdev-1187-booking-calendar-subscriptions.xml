<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

  <changeSet id="rsdev-1187-booking-calendar-subscriptions" author="researchspace" context="run">
    <comment>Create revocable bookable-item calendar subscriptions</comment>
    <createTable tableName="BookableItemCalendarSubscription">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="bookingConfiguration_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="user_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tokenHash" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="updatedAt" type="DATETIME(6)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addUniqueConstraint
        tableName="BookableItemCalendarSubscription"
        columnNames="bookingConfiguration_id, user_id"
        constraintName="UK_BookableItemCalendarSubscription_configuration_user"/>
    <addUniqueConstraint
        tableName="BookableItemCalendarSubscription"
        columnNames="tokenHash"
        constraintName="UK_BookableItemCalendarSubscription_tokenHash"/>
    <addForeignKeyConstraint
        constraintName="FK_BookableItemCalendarSubscription_configuration"
        baseTableName="BookableItemCalendarSubscription"
        baseColumnNames="bookingConfiguration_id"
        referencedTableName="BookingConfiguration"
        referencedColumnNames="id"
        onDelete="CASCADE"/>
    <addForeignKeyConstraint
        constraintName="FK_BookableItemCalendarSubscription_user"
        baseTableName="BookableItemCalendarSubscription"
        baseColumnNames="user_id"
        referencedTableName="User"
        referencedColumnNames="id"
        onDelete="CASCADE"/>
    <sql>
      ALTER TABLE BookableItemCalendarSubscription ENGINE=InnoDB,
      CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci
    </sql>
  </changeSet>
</databaseChangeLog>
