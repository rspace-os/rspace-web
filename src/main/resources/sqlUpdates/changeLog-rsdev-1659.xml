<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd">

    <changeSet id="2026-11-09-nfs-field-link-table" context="run" author="nferrante">
        <comment>RSDEV-1659: create NfsFieldLink, the index of filestore links in text fields</comment>
        <!-- ids come from hibernate_sequences, so not autoIncrement -->
        <createTable tableName="NfsFieldLink">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="field_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_nfsfieldlink_field"
                             references="Field(id)"/>
            </column>
            <column name="fileStore_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_nfsfieldlink_filestore"
                             references="NfsFileStore(id)"/>
            </column>
            <column name="fileSystem_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_nfsfieldlink_filesystem"
                             references="NfsFileSystem(id)"/>
            </column>
            <column name="relPath" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="absolutePath" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>alter table NfsFieldLink engine=InnoDB, CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;</sql>
        <!-- createIndex cannot express the (191) prefix -->
        <sql>create index idx_nfsfieldlink_fs_path on NfsFieldLink (fileSystem_id, absolutePath(191));</sql>
    </changeSet>

    <changeSet id="2026-11-11-nfs-field-link-exact-paths" context="run" author="nferrante">
        <comment>RSDEV-1659: compare NfsFieldLink paths case-sensitively, as S3 keys and most filesystems do</comment>
        <!-- ponytail: utf8mb4_bin still pads trailing spaces; a NO PAD collation differs between MariaDB and MySQL -->
        <sql>alter table NfsFieldLink
            modify relPath VARCHAR(1024) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
            modify absolutePath VARCHAR(1024) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL;</sql>
    </changeSet>
</databaseChangeLog>
