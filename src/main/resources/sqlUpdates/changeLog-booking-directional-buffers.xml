<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd">
  <changeSet id="booking-directional-buffers" author="tchoi-rs" context="run">
    <comment>Restore directional booking gaps, retaining the configured gap on both sides.</comment>
    <renameColumn tableName="BookingConfiguration" oldColumnName="bufferMinutes" newColumnName="bufferBeforeMinutes" columnDataType="BIGINT"/>
    <addColumn tableName="BookingConfiguration"><column name="bufferAfterMinutes" type="BIGINT"/></addColumn>
    <sql>UPDATE BookingConfiguration SET bufferAfterMinutes = bufferBeforeMinutes</sql>
    <addNotNullConstraint tableName="BookingConfiguration" columnName="bufferBeforeMinutes" columnDataType="BIGINT"/>
    <addDefaultValue tableName="BookingConfiguration" columnName="bufferBeforeMinutes" columnDataType="BIGINT" defaultValueNumeric="0"/>
    <addNotNullConstraint tableName="BookingConfiguration" columnName="bufferAfterMinutes" columnDataType="BIGINT"/>
    <addDefaultValue tableName="BookingConfiguration" columnName="bufferAfterMinutes" columnDataType="BIGINT" defaultValueNumeric="0"/>
    <renameColumn tableName="BookingConfigurationDefaults" oldColumnName="bufferMinutes" newColumnName="bufferBeforeMinutes" columnDataType="BIGINT"/>
    <addColumn tableName="BookingConfigurationDefaults"><column name="bufferAfterMinutes" type="BIGINT"/></addColumn>
    <sql>UPDATE BookingConfigurationDefaults SET bufferAfterMinutes = bufferBeforeMinutes</sql>
    <addNotNullConstraint tableName="BookingConfigurationDefaults" columnName="bufferBeforeMinutes" columnDataType="BIGINT"/>
    <addNotNullConstraint tableName="BookingConfigurationDefaults" columnName="bufferAfterMinutes" columnDataType="BIGINT"/>
    <renameColumn tableName="BookingConfiguration_AUD" oldColumnName="bufferMinutes" newColumnName="bufferBeforeMinutes" columnDataType="BIGINT"/>
    <addColumn tableName="BookingConfiguration_AUD"><column name="bufferAfterMinutes" type="BIGINT"/></addColumn>
    <sql>UPDATE BookingConfiguration_AUD SET bufferAfterMinutes = bufferBeforeMinutes</sql>
    <renameColumn tableName="BookingConfigurationDefaults_AUD" oldColumnName="bufferMinutes" newColumnName="bufferBeforeMinutes" columnDataType="BIGINT"/>
    <addColumn tableName="BookingConfigurationDefaults_AUD"><column name="bufferAfterMinutes" type="BIGINT"/></addColumn>
    <sql>UPDATE BookingConfigurationDefaults_AUD SET bufferAfterMinutes = bufferBeforeMinutes</sql>
  </changeSet>
</databaseChangeLog>
