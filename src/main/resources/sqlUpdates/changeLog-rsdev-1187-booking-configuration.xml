<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

  <changeSet id="rsdev-1187-booking-configuration" author="researchspace" context="run">
    <comment>Create the scalar BookingConfiguration entity</comment>
    <createTable tableName="BookingConfiguration">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="enabled" type="BIT(1)" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="timeZone" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="configurationVersion" type="BIGINT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <sql>
      ALTER TABLE BookingConfiguration ENGINE=InnoDB,
      CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci
    </sql>
  </changeSet>

  <changeSet id="rsdev-1187-booking-configuration-audit" author="researchspace" context="run">
    <comment>Create Envers history for BookingConfiguration</comment>
    <createTable tableName="BookingConfiguration_AUD">
      <column name="id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="REV" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="REVTYPE" type="TINYINT"/>
      <column name="enabled" type="BIT(1)"/>
      <column name="timeZone" type="VARCHAR(255)"/>
      <column name="configurationVersion" type="BIGINT"/>
    </createTable>
    <addPrimaryKey
        tableName="BookingConfiguration_AUD"
        columnNames="id, REV"
        constraintName="PK_BookingConfiguration_AUD"/>
    <addForeignKeyConstraint
        constraintName="FK_BookingConfiguration_AUD_REV"
        baseTableName="BookingConfiguration_AUD"
        baseColumnNames="REV"
        referencedTableName="REVINFO"
        referencedColumnNames="REV"/>
    <sql>
      ALTER TABLE BookingConfiguration_AUD ENGINE=InnoDB,
      CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci
    </sql>
  </changeSet>

  <changeSet id="rsdev-1187-booking-configuration-target" author="researchspace" context="run">
    <preConditions onFail="HALT" onError="HALT">
      <sqlCheck expectedResult="0">SELECT COUNT(*) FROM BookingConfiguration</sqlCheck>
    </preConditions>
    <comment>Add the required polymorphic booking target</comment>
    <addColumn tableName="BookingConfiguration">
      <column name="targetType" type="VARCHAR(32)">
        <constraints nullable="false"/>
      </column>
      <column name="targetId" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </addColumn>
    <addUniqueConstraint
        tableName="BookingConfiguration"
        columnNames="targetType, targetId"
        constraintName="UK_BookingConfiguration_target"/>
    <createIndex tableName="BookingConfiguration" indexName="IX_BookingConfiguration_targetId">
      <column name="targetId"/>
    </createIndex>
  </changeSet>

  <changeSet id="rsdev-1187-booking-configuration-target-audit" author="researchspace" context="run">
    <comment>Audit polymorphic booking target changes</comment>
    <addColumn tableName="BookingConfiguration_AUD">
      <column name="targetType" type="VARCHAR(32)"/>
      <column name="targetId" type="BIGINT"/>
    </addColumn>
  </changeSet>
</databaseChangeLog>
