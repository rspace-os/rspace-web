<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

  <changeSet id="rsdev-1187-time-slot-booking-kind" author="researchspace" context="run">
    <comment>Add immutable event kind and optimistic version to time-slot bookings</comment>
    <addColumn tableName="TimeSlotBooking">
      <column name="kind" type="VARCHAR(32)" defaultValue="BOOKING">
        <constraints nullable="false"/>
      </column>
      <column name="version" type="BIGINT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="rsdev-1187-time-slot-booking-kind-audit" author="researchspace" context="run">
    <comment>Retain event kind in Envers history</comment>
    <addColumn tableName="TimeSlotBooking_AUD">
      <column name="kind" type="VARCHAR(32)" defaultValue="BOOKING"/>
    </addColumn>
  </changeSet>
</databaseChangeLog>
