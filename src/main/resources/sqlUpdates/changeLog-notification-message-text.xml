<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd">
    <changeSet id="notification-message-text" author="rspace" context="run">
        <comment>Widen Notification.notificationMessage from varchar(2000) to MEDIUMTEXT so system notification messages are stored in full instead of being truncated.</comment>
        <modifyDataType tableName="Notification" columnName="notificationMessage" newDataType="MEDIUMTEXT"/>
    </changeSet>
</databaseChangeLog>
