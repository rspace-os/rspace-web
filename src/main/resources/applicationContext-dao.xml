<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
            http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- Applies the Liquibase schema changes at startup. -->
    <bean depends-on="appContextRetriever, loggingInitializer" id="liquibase" class="liquibase.integration.spring.SpringLiquibase">
        <property name="dataSource" ref="dataSource" />
        <property name="changeLog" value="classpath:sqlUpdates/liquibase-master.xml" />
        <!-- Runtime Liquibase contexts. The pom excludes this file from Maven filtering and
             re-adds it unfiltered, so ${liquibase.context} resolves from deployment.properties
             when the server starts. The copy under src/test/resources is filtered, so there
             Maven substitutes the same placeholder at build time. -->
        <property name="contexts" value="${liquibase.context}" />
    </bean>

    <bean class="org.springframework.dao.annotation.PersistenceExceptionTranslationPostProcessor" />
		
	<bean id="sessionFactory" class="org.springframework.orm.hibernate5.LocalSessionFactoryBean">
    	<property name="dataSource" ref="dataSource" />
    	<property name="configLocations" value="classpath:hibernate.cfg.xml" />
    	<property name="hibernateProperties">
    		<value>
    			hibernate.dialect=${hibernate.dialect}
    			hibernate.search.backend.type=lucene
    			hibernate.search.backend.directory.root=${rs.hibernate.searchIndex.folder}
    			hibernate.search.backend.directory.type=local-filesystem
    			hibernate.cache.use_second_level_cache=true
    			hibernate.cache.use_query_cache=true
    			hibernate.cache.region.factory_class=org.hibernate.cache.jcache.JCacheRegionFactory
    			<!-- hibernate-jcache reads only the hibernate.javax.cache.* keys, because JCache never
    			     moved to the jakarta namespace. Hibernate's ClassLoaderService resolves the uri as a
    			     classpath resource, so it takes no classpath: prefix. Given a wrong key or uri,
    			     Hibernate falls back to an empty default CacheManager without raising an error, and
    			     every region becomes an untuned create-warn default with unlimited size and no expiry.
    			     SecondLevelCacheTestIT guards this wiring. -->
    			hibernate.javax.cache.provider=org.ehcache.jsr107.EhcacheCachingProvider
    			hibernate.javax.cache.uri=ehcache.xml
    			<!-- The hibernate-jcache default, made explicit and pinned by EhcacheRegionConfigTest.
    			     When ehcache.xml has no matching region, Hibernate creates one untuned, with unbounded
    			     heap and no expiry, and logs a warning instead of failing startup.
    			     EhcacheRegionConfigTest keeps ehcache.xml complete, so that path should never run. -->
    			hibernate.javax.cache.missing_cache_strategy=create-warn
			hibernate.search.indexing.plan.synchronization.strategy=sync
			<!-- Index mappings live on the entities themselves, as annotations from
			     org.hibernate.search.mapper.pojo. Lucene analysis is configured by
			     RSpaceLuceneAnalysisConfigurer, which hibernate.cfg.xml names. -->
    			<!-- Id generation for TABLE-strategy entities. Every such entity carries an explicit
    			     @TableGenerator keyed to its own row in hibernate_sequences. Where a generator declares
    			     no pkColumnValue, Hibernate segments it by the entity's physical table name, because
    			     prefer_entity_table_as_segment_value defaults to true for annotation-defined table
    			     generators. That keeps the one counter per table layout Hibernate 5 used.
    			     The two TABLE_PER_CLASS hierarchies, AbstractUserOrGroupImpl and Communication, pin
    			     pkColumnValue explicitly because sibling tables must share one counter. On upgrade,
    			     changeLog-rsdev-444.xml re-seeds every row above its table's MAX(id), so allocation
    			     cannot collide with pre-upgrade ids. Do NOT add a bare @GeneratedValue(strategy=TABLE)
    			     without a generator. It would allocate from a shared "default" segment, which
    			     TableIdGeneratorConfigTest fails on. See DevDocs/DeveloperNotes/UpgradingToSpring6.md,
    			     "What the migration changes in the database". -->
    		</value>
    	</property>
    </bean>

    <bean id="blazeCriteriaConfiguration"
          class="com.researchspace.dao.query.BlazeCriteriaConfiguration"
          factory-method="create" />
    <bean id="criteriaBuilderFactory"
          factory-bean="blazeCriteriaConfiguration"
          factory-method="createCriteriaBuilderFactory">
        <constructor-arg ref="sessionFactory" />
    </bean>

</beans>
