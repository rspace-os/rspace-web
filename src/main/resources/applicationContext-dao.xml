<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
            http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <!--  used to apply liquibase DB schema changes -->
    <bean depends-on="appContextRetriever, loggingInitializer" id="liquibase" class="liquibase.integration.spring.SpringLiquibase">
        <property name="dataSource" ref="dataSource" />
        <property name="changeLog" value="classpath:sqlUpdates/liquibase-master.xml" />
        <!-- Runtime Liquibase contexts. This file is excluded from Maven filtering (see pom.xml),
             so ${liquibase.context} resolves from deployment.properties at runtime. -->
        <property name="contexts" value="${liquibase.context}" />
    </bean>

    <bean class="org.springframework.dao.annotation.PersistenceExceptionTranslationPostProcessor" />
		
	<bean id="sessionFactory" class="org.springframework.orm.hibernate5.LocalSessionFactoryBean">
    	<property name="dataSource" ref="dataSource" />
    	<property name="configLocations" value="classpath:hibernate.cfg.xml" />
    	<property name="hibernateProperties">
			<props>
				<prop key="hibernate.dialect">${hibernate.dialect}</prop>
				<prop key="hibernate.search.backend.type">lucene</prop>
				<prop key="hibernate.search.backend.directory.root">${rs.hibernate.searchIndex.folder}</prop>
				<prop key="hibernate.search.backend.directory.type">local-filesystem</prop>
				<prop key="hibernate.cache.use_second_level_cache">true</prop>
				<prop key="hibernate.cache.use_query_cache">true</prop>
				<prop key="hibernate.cache.region.factory_class">org.hibernate.cache.jcache.JCacheRegionFactory</prop>
				<!-- Hibernate 6.4's JCache integration uses the hibernate.javax.cache.* settings. The URI
				     is resolved as a classpath resource; an invalid URI prevents SessionFactory startup. -->
				<prop key="hibernate.javax.cache.provider">org.ehcache.jsr107.EhcacheCachingProvider</prop>
				<prop key="hibernate.javax.cache.uri">ehcache.xml</prop>
				<!-- A missing region is created with JCache's default configuration and a warning. Keep
				     ehcache.xml complete so the configured regions retain their intended limits. -->
				<prop key="hibernate.javax.cache.missing_cache_strategy">create-warn</prop>
				<prop key="hibernate.search.indexing.plan.synchronization.strategy">sync</prop>
				<prop key="jakarta.persistence.validation.factory">#{@validator}</prop>
				<!-- Id generation for TABLE-strategy entities: every such entity carries an explicit
				     @TableGenerator, keyed to its own row in hibernate_sequences.
				     Generators declared without pkColumnValue segment by the entity's physical table
				     name (Hibernate defaults prefer_entity_table_as_segment_value=true for
				     annotation-defined table generators), preserving the one-counter-per-table layout
				     Hibernate 5 used. The two TABLE_PER_CLASS hierarchies (AbstractUserOrGroupImpl,
				     Communication) pin pkColumnValue explicitly because sibling tables share one counter.
				     On upgrade, changeLog-rsdev-444.xml re-seeds every row above its table's MAX(id),
				     avoiding collisions with pre-upgrade ids. -->
			</props>
    	</property>
    </bean>

    <import resource="classpath:applicationContext-blaze.xml" />

</beans>
