{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "target": "ES2024",
    "jsx": "react-jsx",
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    // These expose widespread pre-existing array-index and optional-property typing errors;
    // migrate those incrementally before enabling the checks (RSDEV-1242).
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      // The backend's own resources, read by tests that must stay pinned to the server's files
      // (operations_config.json). A seven-level relative path out of the Vite root was unreadable
      // and broke on any move (parallel review, FE13); vite.config.ts resolves this via
      // tsconfigPaths, and vitestAliases repeats it for the test runs that bypass that.
      "@resources/*": ["../../resources/*"]
    },
    "resolveJsonModule": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["@vitest/browser/matchers", "@sa11y/vitest", "jquery", "vite/client"]
  },
  "exclude": ["dist", "playwright-report"]
}
