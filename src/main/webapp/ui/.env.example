# Target
RSPACE_BASE_URL=http://localhost:8080

# Sysadmin overrides
RSPACE_SYSADMIN_USERNAME=
RSPACE_SYSADMIN_PASSWORD=
RSPACE_SYSADMIN_API_KEY=

# Runner
E2E_INTEGRATION_MODE=mock
E2E_MOCK_PORT=9099

# Integration credentials
FIELDMARK_API_KEY=
ZENODO_API_KEY=
GALAXY_EU_APIKEY=
PYRAT_API_KEY=

DATAVERSE_API_TOKEN=
DATAVERSE_SERVER_URL=
DATAVERSE_NAME=

DSW_API_KEY=
DSW_SERVER_URL=

OMERO_USERNAME=
OMERO_PASSWORD=

CALIRA_USERNAME=
CALIRA_PASSWORD=

NEXTCLOUD_USERNAME=
NEXTCLOUD_PASS=

IGSN_ACCOUNT_ID=
IGSN_REPO_PREFIX=
IGSN_PASSWORD=
IGSN_SERVER_URL=https://api.test.datacite.org

PIDINST_B2INST_COMMUNITY_ID=
PIDINST_B2INST_TOKEN=
PIDINST_B2INST_SERVER_URL=https://b2inst-test.gwdg.de

# Real-mode filestores. Mock-mode E2E_*_FILESTORE_* values come from
# src/__tests__/e2e/scripts/start-filestore-servers.sh don't copy them here.
E2E_REAL_S3_URL=
E2E_REAL_S3_BUCKET=
E2E_REAL_S3_REGION=auto

E2E_REAL_IRODS_URL=
E2E_REAL_IRODS_USERNAME=
E2E_REAL_IRODS_PASSWORD=

# SFTP and Samba hosts need the VPN.
E2E_REAL_SFTP_URL=
E2E_REAL_SFTP_HOST_KEY=
E2E_REAL_SFTP_USERNAME=
E2E_REAL_SFTP_PASSWORD=

E2E_REAL_SAMBA_URL=
E2E_REAL_SAMBA_SHARE=
E2E_REAL_SAMBA_USERNAME=
E2E_REAL_SAMBA_PASSWORD=
