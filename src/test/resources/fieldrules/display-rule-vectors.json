{
  "description": "Shared vectors for display rules (RPD-339). Run by FieldDisplayRuleVectorsTest (Java) and displayRuleVectors.test.ts (TypeScript); both implementations must agree on every case. Valid rules are compared by JSON value, not by bytes. Keys are UUIDs; K1 is 00000000-0000-4000-8000-000000000001 and so on.",
  "rules": {
    "valid": [
      {
        "name": "is any of",
        "json": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"IS_ANY_OF\",\"values\":[\"Yes\"]}",
        "canonical": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"IS_ANY_OF\",\"values\":[\"Yes\"]}"
      },
      {
        "name": "is none of with several values, properties in another order",
        "json": "{\"values\":[\"CL2\",\"CL3\"],\"operator\":\"IS_NONE_OF\",\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\"}",
        "canonical": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"IS_NONE_OF\",\"values\":[\"CL2\",\"CL3\"]}"
      },
      {
        "name": "has value omits values",
        "json": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"HAS_VALUE\"}",
        "canonical": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"HAS_VALUE\"}"
      },
      {
        "name": "has no value with an empty values array",
        "json": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"HAS_NO_VALUE\",\"values\":[]}",
        "canonical": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"HAS_NO_VALUE\"}"
      },
      {
        "name": "control characters, quotes, backslashes and non-ASCII survive a round trip",
        "json": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"IS_ANY_OF\",\"values\":[\"a\\u001fb\",\"q\\\"uote\",\"back\\\\slash\",\"line\\nbreak\",\"tab\\t\",\"bell\\u0007\",\"é\",\"x y\",\"😀\"]}",
        "canonical": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"IS_ANY_OF\",\"values\":[\"a\\u001fb\",\"q\\\"uote\",\"back\\\\slash\",\"line\\nbreak\",\"tab\\t\",\"bell\\u0007\",\"é\",\"x y\",\"😀\"]}"
      },
      {
        "name": "a lone surrogate survives a round trip",
        "json": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"IS_ANY_OF\",\"values\":[\"x\\uD800y\"]}",
        "canonical": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"IS_ANY_OF\",\"values\":[\"x\\ud800y\"]}"
      },
      {
        "name": "a repeated property takes its last value, as JSON.parse does",
        "json": "{\"sourceFieldKey\":\"x\",\"operator\":\"BAD\",\"operator\":\"HAS_VALUE\"}",
        "canonical": "{\"sourceFieldKey\":\"x\",\"operator\":\"HAS_VALUE\"}"
      },
      {
        "name": "a vertical tab survives a round trip",
        "json": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"IS_ANY_OF\",\"values\":[\"v\\u000bt\"]}",
        "canonical": "{\"sourceFieldKey\":\"00000000-0000-4000-8000-000000000001\",\"operator\":\"IS_ANY_OF\",\"values\":[\"v\\u000bt\"]}"
      },
      {
        "name": "a repeated source key takes its last value",
        "json": "{\"sourceFieldKey\":7,\"sourceFieldKey\":\"k\",\"operator\":\"HAS_VALUE\"}",
        "canonical": "{\"sourceFieldKey\":\"k\",\"operator\":\"HAS_VALUE\"}"
      },
      {
        "name": "repeated values take their last value",
        "json": "{\"values\":[1],\"values\":[],\"sourceFieldKey\":\"k\",\"operator\":\"HAS_VALUE\"}",
        "canonical": "{\"sourceFieldKey\":\"k\",\"operator\":\"HAS_VALUE\"}"
      }
    ],
