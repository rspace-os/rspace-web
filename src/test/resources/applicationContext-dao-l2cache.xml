<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
      Add after the default test context locations to replace the shared test sessionFactory with
      one that has the production second-level cache settings (src/main/resources/applicationContext-dao.xml).
      Some Hibernate behaviour only happens when an entity is L2-cacheable: with
      hibernate.default_batch_fetch_size set, an EAGER to-one owned by a cacheable entity is
      resolved as a proxy and batch-initialised, instead of as the real instance.

      Only one test context should use this file. JCache CacheManagers are JVM singletons keyed
      by URI, and closing a SessionFactory closes its CacheManager (see the comment in
      applicationContext-dao.xml).
    -->
    <bean id="sessionFactory" class="org.springframework.orm.hibernate5.LocalSessionFactoryBean">
        <property name="dataSource" ref="dataSource" />
        <property name="configLocations" value="classpath:hibernate.cfg.xml" />
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.dialect">${hibernate.dialect}</prop>
                <prop key="hibernate.search.backend.type">lucene</prop>
                <prop key="hibernate.search.backend.directory.type">local-heap</prop>
                <prop key="hibernate.cache.use_second_level_cache">true</prop>
                <prop key="hibernate.cache.use_query_cache">true</prop>
                <prop key="hibernate.cache.region.factory_class">org.hibernate.cache.jcache.JCacheRegionFactory</prop>
                <prop key="hibernate.javax.cache.provider">org.ehcache.jsr107.EhcacheCachingProvider</prop>
                <prop key="hibernate.javax.cache.uri">ehcache.xml</prop>
                <prop key="hibernate.javax.cache.missing_cache_strategy">create-warn</prop>
                <prop key="hibernate.search.indexing.plan.synchronization.strategy">sync</prop>
                <prop key="jakarta.persistence.validation.factory">#{@validator}</prop>
            </props>
        </property>
    </bean>

</beans>
